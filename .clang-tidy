# Static analysis, see Architecture.md. Runs on the sources in src/ (not tests/, third_party/ or fetched
# dependencies). In CI every warning is an error.
#
# Disabled checks, with the reason:
# - modernize-use-trailing-return-type: style only, the project uses classic return types
# - cppcoreguidelines-avoid-magic-numbers: alias of readability-magic-numbers, which is not enabled; constants
#   with a name are required by review instead
# - cppcoreguidelines-pro-bounds-pointer-arithmetic, cppcoreguidelines-pro-bounds-constant-array-index: std::span
#   and indexing in audio loops are the point of those loops
# - cppcoreguidelines-non-private-member-variables-in-classes, misc-non-private-member-variables-in-classes:
#   plain data structs (snapshots, configs, commands) have public members on purpose
# - cppcoreguidelines-avoid-const-or-ref-data-members: references as members are used for non-owning wiring
# - misc-include-cleaner: reports transitive includes of the standard library differently per implementation
# - misc-no-recursion: no recursion is used; the check is noisy on visitors
# - modernize-use-designated-initializers: small well-known aggregates (Rect, Color, commands) read better
#   positionally; configs use designated initializers where fields could be mixed up
# - cppcoreguidelines-pro-bounds-avoid-unchecked-container-access: the alternative at() throws, which the audio
#   thread must not; loop bounds are checked instead
# - bugprone-easily-swappable-parameters: coordinates, sizes, ranges and index pairs (x/y, menu/item, min/max) come
#   in pairs by nature; a strong type for each pair would cost more readability than it wins. Tests cover the order
Checks: >
  -*,
  bugprone-*,
  cppcoreguidelines-*,
  misc-*,
  modernize-*,
  performance-*,
  readability-identifier-naming,
  -modernize-use-trailing-return-type,
  -cppcoreguidelines-avoid-magic-numbers,
  -cppcoreguidelines-pro-bounds-pointer-arithmetic,
  -cppcoreguidelines-pro-bounds-constant-array-index,
  -cppcoreguidelines-non-private-member-variables-in-classes,
  -misc-non-private-member-variables-in-classes,
  -cppcoreguidelines-avoid-const-or-ref-data-members,
  -misc-include-cleaner,
  -misc-no-recursion,
  -modernize-use-designated-initializers,
  -cppcoreguidelines-pro-bounds-avoid-unchecked-container-access,
  -bugprone-easily-swappable-parameters

HeaderFilterRegex: '.*/src/.*'

CheckOptions:
  # Classes deriving from a non-copyable interface do not need to repeat the deleted copy/move operations
  cppcoreguidelines-special-member-functions.AllowImplicitlyDeletedCopyOrMove: true
  # miniaudio's C structs are zero-initialized before ma_*_init fills them; a zero device type is never used
  bugprone-invalid-enum-default-initialization.IgnoredEnums: '::std::errc;::ma_device_type'
  readability-identifier-naming.NamespaceCase: lower_case
  readability-identifier-naming.ClassCase: CamelCase
  readability-identifier-naming.StructCase: CamelCase
  readability-identifier-naming.EnumCase: CamelCase
  readability-identifier-naming.EnumConstantCase: CamelCase
  readability-identifier-naming.TypeAliasCase: CamelCase
  readability-identifier-naming.TemplateParameterCase: CamelCase
  readability-identifier-naming.FunctionCase: camelBack
  readability-identifier-naming.MethodCase: camelBack
  readability-identifier-naming.VariableCase: lower_case
  readability-identifier-naming.ParameterCase: lower_case
  readability-identifier-naming.MemberCase: lower_case
  readability-identifier-naming.ConstexprVariableCase: lower_case
  readability-identifier-naming.MacroDefinitionCase: UPPER_CASE
