		<title>Features History Release DJ Workstation ogg/vorbis mp3 mix open source </title>
		<link rel="stylesheet" type="text/css" href="djw_styles.css" />
	</head>
	<body>
		<div id="main">
			<a href="index.html.en"><img src="bilder/logo.gif" style="width:150px;height:72px;padding-right:10px;" alt="dj-workstation Logo" /></a>
	
