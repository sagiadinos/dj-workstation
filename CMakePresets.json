{
    "version": 6,
    "cmakeMinimumRequired": {
        "major": 3,
        "minor": 25,
        "patch": 0
    },
    "configurePresets": [
        {
            "name": "base",
            "hidden": true,
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build/${presetName}",
            "cacheVariables": {
                "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
            }
        },
        {
            "name": "linux-base",
            "hidden": true,
            "inherits": "base",
            "condition": {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Linux"
            }
        },
        {
            "name": "windows-base",
            "hidden": true,
            "inherits": "base",
            "condition": {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Windows"
            }
        },
        {
            "name": "macos-base",
            "hidden": true,
            "inherits": "base",
            "condition": {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Darwin"
            }
        },
        {
            "name": "linux-debug",
            "displayName": "linux-debug",
            "description": "Linux x86_64, debug with tests",
            "inherits": "linux-base",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug"
            }
        },
        {
            "name": "linux-release-base",
            "hidden": true,
            "description": "Release with link-time optimization; unused code is dropped and the symbols are stripped. -Wno-stringop-overread at the link: with LTO GCC reports reads that do not happen (std::string concatenation, SQLite's strlen); compiled without LTO the same code is quiet",
            "inherits": "linux-base",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release",
                "CMAKE_INTERPROCEDURAL_OPTIMIZATION": "ON",
                "CMAKE_C_FLAGS_RELEASE": "-O3 -DNDEBUG -ffunction-sections -fdata-sections",
                "CMAKE_CXX_FLAGS_RELEASE": "-O3 -DNDEBUG -ffunction-sections -fdata-sections",
                "CMAKE_EXE_LINKER_FLAGS_RELEASE": "-Wl,--gc-sections -s -Wno-stringop-overread"
            }
        },
        {
            "name": "linux-release",
            "displayName": "linux-release",
            "description": "Linux x86_64, release",
            "inherits": "linux-release-base"
        },
        {
            "name": "linux-arm64-release",
            "displayName": "linux-arm64-release",
            "description": "Native build on Raspberry Pi 4/5 (arm64), tuned for the Pi 4 baseline",
            "inherits": "linux-release-base",
            "cacheVariables": {
                "CMAKE_CXX_FLAGS": "-mcpu=cortex-a72"
            }
        },
        {
            "name": "windows-debug",
            "displayName": "windows-debug",
            "description": "Windows, MSVC, debug with tests",
            "inherits": "windows-base",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug"
            }
        },
        {
            "name": "windows-release",
            "displayName": "windows-release",
            "description": "Windows, MSVC, release",
            "inherits": "windows-base",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release"
            }
        },
        {
            "name": "macos-debug",
            "displayName": "macos-debug",
            "description": "macOS, debug with tests",
            "inherits": "macos-base",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug"
            }
        },
        {
            "name": "macos-release",
            "displayName": "macos-release",
            "description": "macOS, release",
            "inherits": "macos-base",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release"
            }
        },
        {
            "name": "linux-asan",
            "displayName": "linux-asan",
            "description": "Linux, debug with ASan, LeakSanitizer and UBSan",
            "inherits": "linux-base",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "DJW_BUILD_TESTS": "ON",
                "DJW_SANITIZE": "address"
            }
        },
        {
            "name": "linux-tsan",
            "displayName": "linux-tsan",
            "description": "Linux, debug with TSan",
            "inherits": "linux-base",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "DJW_BUILD_TESTS": "ON",
                "DJW_SANITIZE": "thread"
            }
        }
    ],
    "buildPresets": [
        {
            "name": "linux-debug",
            "configurePreset": "linux-debug"
        },
        {
            "name": "linux-release",
            "configurePreset": "linux-release"
        },
        {
            "name": "linux-arm64-release",
            "configurePreset": "linux-arm64-release"
        },
        {
            "name": "windows-debug",
            "configurePreset": "windows-debug"
        },
        {
            "name": "windows-release",
            "configurePreset": "windows-release"
        },
        {
            "name": "macos-debug",
            "configurePreset": "macos-debug"
        },
        {
            "name": "macos-release",
            "configurePreset": "macos-release"
        },
        {
            "name": "linux-asan",
            "configurePreset": "linux-asan"
        },
        {
            "name": "linux-tsan",
            "configurePreset": "linux-tsan"
        }
    ],
    "testPresets": [
        {
            "name": "linux-debug",
            "configurePreset": "linux-debug",
            "output": {
                "outputOnFailure": true
            }
        },
        {
            "name": "linux-release",
            "configurePreset": "linux-release",
            "output": {
                "outputOnFailure": true
            }
        },
        {
            "name": "linux-arm64-release",
            "configurePreset": "linux-arm64-release",
            "output": {
                "outputOnFailure": true
            }
        },
        {
            "name": "windows-debug",
            "configurePreset": "windows-debug",
            "output": {
                "outputOnFailure": true
            }
        },
        {
            "name": "windows-release",
            "configurePreset": "windows-release",
            "output": {
                "outputOnFailure": true
            }
        },
        {
            "name": "macos-debug",
            "configurePreset": "macos-debug",
            "output": {
                "outputOnFailure": true
            }
        },
        {
            "name": "macos-release",
            "configurePreset": "macos-release",
            "output": {
                "outputOnFailure": true
            }
        },
        {
            "name": "linux-asan",
            "configurePreset": "linux-asan",
            "output": {
                "outputOnFailure": true
            },
            "environment": {
                "ASAN_OPTIONS": "detect_leaks=1:abort_on_error=1:strict_string_checks=1",
                "UBSAN_OPTIONS": "print_stacktrace=1:halt_on_error=1:suppressions=${sourceDir}/tests/sanitizers/ubsan.supp"
            }
        },
        {
            "name": "linux-tsan",
            "configurePreset": "linux-tsan",
            "output": {
                "outputOnFailure": true
            },
            "environment": {
                "TSAN_OPTIONS": "halt_on_error=1:second_deadlock_stack=1:suppressions=${sourceDir}/tests/sanitizers/tsan.supp"
            }
        }
    ]
}
