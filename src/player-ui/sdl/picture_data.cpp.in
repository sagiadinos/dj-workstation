// Generated by CMake from misc/logo: the logos as SVG text, built into the program. Do not edit.

#include "picture.hpp"

namespace djw::player_ui::sdl
{
    namespace
    {
        constexpr char logo_svg[] = {@logo_bytes@};
        constexpr char icon_svg[] = {@icon_bytes@};
    } // namespace

    std::string_view svgOf(Picture picture) noexcept
    {
        switch (picture)
        {
            case Picture::Logo:
                return {logo_svg, sizeof(logo_svg)};
            case Picture::Icon:
                return {icon_svg, sizeof(icon_svg)};
        }
        return {};
    }
} // namespace djw::player_ui::sdl
